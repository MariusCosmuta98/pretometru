{
  "name": "pretometru",
  "version": "0.0.0",
  "private": true,
  "description": "Receipt-to-price-tracker PWA: reads store receipts, tracks prices per product and store.",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:leaks": "node scripts/check-leaks.ts",
    "ocr:bench": "node scripts/ocr-bench.ts",
    "check": "npm run check:leaks && npm run lint && npm run typecheck && npm test && npm run build",
    "e2e": "npm run build && playwright test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "fuse.js": "^7.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tesseract.js": "^7.0.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ron": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
